---
import Base from '../layouts/Base.astro';
import { APP, ROTAS, type Lingua } from '../i18n';

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;

const T = {
  pt: {
    descricao: 'Selah é um jogo de enigmas bíblicos em português: 14 tipos de puzzle em 12 temas, da Criação ao Apocalipse. Sem anúncios, sem vidas, sem pressa.',
    chamada: '"Selah" é a pausa dos Salmos: o convite para parar e pensar.',
    texto: 'Em Selah você para, pensa e descobre a Bíblia em 14 tipos de enigma, em 12 temas, da Criação ao Apocalipse. Cada estrela ergue uma pedra do Templo de Salomão.',
    emBreve: 'Em breve',
    lojas: 'Em breve na App Store e no Google Play',
    recursosTitulo: 'O que tem no Selah',
    recursos: [
      { t: '14 enigmas, cada um com a sua história', d: 'Cada tipo de enigma é apresentado por um personagem da Bíblia, de Esdras, o escriba, à rainha de Sabá.' },
      { t: '12 temas, 360 fases', d: 'Da Criação ao Apocalipse, 30 fases por tema, com um versículo da Bíblia Livre em cada fase e dificuldade que se ajusta ao seu ritmo.' },
      { t: 'O Templo de Salomão', d: 'Cada estrela conquistada ergue uma pedra do Templo, do alicerce ao santuário.' },
      { t: 'Desafio do dia', d: 'Um enigma novo todos os dias, para quem gosta de uma pausa diária. Se faltar um dia, tudo bem: aqui não há cobrança.' },
      { t: 'Coleção', d: 'Conheça os personagens que apresentam cada enigma e reúna os cartões da coleção.' },
      { t: 'Feito para jogar em paz', d: 'Sem anúncios, sem compras, sem vidas e sem contagem regressiva. Sem conta, funciona sem internet e os seus dados ficam só no seu aparelho.' },
    ],
    enigmasTitulo: 'Os 14 enigmas',
    enigmas: [
      'Palavras cruzadas, com Esdras, o escriba',
      'Caça-palavras da moeda perdida',
      'Forca das 30 moedas',
      'Anagramas da torre de Babel',
      'Criptograma da escrita na parede, com Daniel',
      'Charadas "quem sou eu", com o enigma de Sansão',
      'Quiz das perguntas difíceis da rainha de Sabá',
      'Sudoku das doze pedras do peitoral de Arão',
      'Rede de letras, com Pedro',
      'Combinar 3 nos celeiros do Egito, com José',
      'Combinar 3 no palácio da rainha Ester',
      'Quebra-cabeça de encaixe do muro de Jerusalém, com Neemias',
      'Deslizar e juntar os pães e peixes',
      'Ordenar as cores nas talhas de Caná',
    ],
    temasTitulo: 'Os 12 temas',
    temas: [
      'Criação e origens',
      'Patriarcas',
      'Êxodo e deserto',
      'Juízes e heróis',
      'Reis de Israel',
      'Profetas',
      'Salmos e sabedoria',
      'Nascimento e infância de Jesus',
      'Milagres',
      'Parábolas',
      'Paixão e ressurreição',
      'Igreja primitiva e Apocalipse',
    ],
    acessibilidade: 'Lembrete diário opcional (no máximo um por dia), tamanho de texto ajustável, modo para daltônicos e opção de reduzir movimento.',
    idioma: '',
    suporte: 'Dúvidas ou sugestões?',
    suporteLink: 'Fale com a gente',
  },
  en: {
    descricao: 'Selah is a Bible puzzle game in Brazilian Portuguese: 14 kinds of puzzles across 12 themes, from Creation to Revelation. No ads, no lives, no rush.',
    chamada: '"Selah" is the pause of the Psalms: an invitation to stop and think.',
    texto: 'In Selah you stop, think and discover the Bible through 14 kinds of puzzles across 12 themes, from Creation to Revelation. Every star raises a stone of Solomon\'s Temple.',
    emBreve: 'Coming soon',
    lojas: 'Coming soon to the App Store and Google Play',
    recursosTitulo: 'What\'s inside',
    recursos: [
      { t: '14 puzzles, each with its own story', d: 'Each kind of puzzle is presented by a Bible character, from Ezra the scribe to the Queen of Sheba.' },
      { t: '12 themes, 360 levels', d: 'From Creation to Revelation, 30 levels per theme, with a verse from the Bíblia Livre in every level and difficulty that adapts to your pace.' },
      { t: 'Solomon\'s Temple', d: 'Every star you earn raises a stone of the Temple, from the foundation to the sanctuary.' },
      { t: 'Daily challenge', d: 'A new puzzle every day for those who enjoy a daily pause. Miss a day? That is fine: there is no penalty here.' },
      { t: 'Collection', d: 'Meet the characters who present each puzzle and collect their cards.' },
      { t: 'Made to play in peace', d: 'No ads, no purchases, no lives and no countdowns. No account, works offline, and your data stays on your device.' },
    ],
    enigmasTitulo: 'The 14 puzzles',
    enigmas: [
      'Crosswords, with Ezra the scribe',
      'Word search of the lost coin',
      'Hangman of the 30 coins',
      'Anagrams of the Tower of Babel',
      'Cryptogram of the writing on the wall, with Daniel',
      '"Who am I" riddles, with Samson\'s riddle',
      'Quiz of the hard questions of the Queen of Sheba',
      'Sudoku of the twelve stones of Aaron\'s breastplate',
      'Net of letters, with Peter',
      'Match-3 in the granaries of Egypt, with Joseph',
      'Match-3 in Queen Esther\'s palace',
      'Jigsaw of the wall of Jerusalem, with Nehemiah',
      'Slide and merge the loaves and fishes',
      'Sort the colors in the jars of Cana',
    ],
    temasTitulo: 'The 12 themes',
    temas: [
      'Creation and origins',
      'Patriarchs',
      'Exodus and the wilderness',
      'Judges and heroes',
      'Kings of Israel',
      'Prophets',
      'Psalms and wisdom',
      'Birth and childhood of Jesus',
      'Miracles',
      'Parables',
      'Passion and resurrection',
      'Early church and Revelation',
    ],
    acessibilidade: 'Optional daily reminder (at most one a day), adjustable text size, color-blind mode and a reduce-motion option.',
    idioma: 'The app is available in Brazilian Portuguese.',
    suporte: 'Questions or suggestions?',
    suporteLink: 'Get in touch',
  },
}[lingua];
---

<Base lingua={lingua} pagina="inicio" titulo={APP.nome} descricao={T.descricao}>
  <section class="heroi">
    <div class="faixa">
      <img class="logo" src="/img/logo.webp" alt={APP.nome} width="600" height="300" />
      <p class="lema">{APP.lema[lingua]}</p>
      <p class="chamada">{T.chamada}</p>
      <p class="texto">{T.texto}</p>
      {T.idioma ? <p class="idioma">{T.idioma}</p> : null}
      <div class="lojas" role="group" aria-label={T.lojas}>
        <span class="loja" aria-disabled="true"><small>{T.emBreve}</small>App Store</span>
        <span class="loja" aria-disabled="true"><small>{T.emBreve}</small>Google Play</span>
      </div>
    </div>
  </section>

  <section class="recursos faixa" aria-labelledby="recursos-titulo">
    <h2 id="recursos-titulo">{T.recursosTitulo}</h2>
    <ul>
      {T.recursos.map((r) => (
        <li>
          <h3>{r.t}</h3>
          <p>{r.d}</p>
        </li>
      ))}
    </ul>
    <div class="listas">
      <section aria-labelledby="enigmas-titulo">
        <h2 id="enigmas-titulo">{T.enigmasTitulo}</h2>
        <ul>{T.enigmas.map((e) => <li>{e}</li>)}</ul>
      </section>
      <section aria-labelledby="temas-titulo">
        <h2 id="temas-titulo">{T.temasTitulo}</h2>
        <ol>{T.temas.map((e) => <li>{e}</li>)}</ol>
      </section>
    </div>
    <p class="acessivel">{T.acessibilidade}</p>
    <p class="contato">
      {T.suporte} <a href={ROTAS.suporte[lingua]}>{T.suporteLink}</a>.
    </p>
  </section>
</Base>

<style>
  .heroi {
    background: radial-gradient(ellipse at 50% 35%, #1c3566 0%, #0b1730 70%);
    color: #f3ebda;
    text-align: center;
    padding: 40px 0 48px;
  }
  .logo { width: min(520px, 100%); display: block; margin: 0 auto; }
  .lema { font-family: 'Cinzel', Georgia, serif; color: #f6d98a; font-size: 1.35rem; letter-spacing: 0.06em; margin: 4px 0 18px; }
  .chamada { font-weight: 700; font-size: 1.1rem; margin: 0 auto 8px; max-width: 620px; }
  .texto { margin: 0 auto 12px; max-width: 620px; color: #d9cdb2; }
  .idioma { margin: 0 auto 12px; color: #f6d98a; font-weight: 600; }
  .lojas { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 22px; }
  .loja {
    display: inline-flex; flex-direction: column; align-items: flex-start;
    min-width: 160px; padding: 8px 18px; border-radius: 12px;
    border: 1.5px solid rgba(246, 217, 138, 0.7); background: rgba(0, 0, 0, 0.35);
    color: #fff; font-weight: 700; font-size: 1.1rem; line-height: 1.2; text-align: left;
  }
  .loja small { font-weight: 600; font-size: 0.72rem; color: #f6d98a; text-transform: uppercase; letter-spacing: 0.08em; }

  .recursos { padding-top: 40px; }
  .recursos h2 { text-align: center; font-size: 1.5rem; margin: 0 0 24px; }
  .recursos ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .recursos li { background: var(--cartao); border: 1px solid var(--linha); border-top: 3px solid var(--ouro); border-radius: 12px; padding: 16px 18px; }
  .recursos h3 { font-size: 1.02rem; margin: 0 0 6px; }
  .recursos li p { margin: 0; color: var(--suave); }
  .listas { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; margin-top: 32px; }
  .listas section { background: var(--cartao); border: 1px solid var(--linha); border-radius: 12px; padding: 18px 20px 8px; }
  .listas h2 { font-size: 1.2rem; text-align: left; margin: 0 0 10px; }
  .recursos .listas ul, .recursos .listas ol { list-style: revert; display: block; padding-left: 22px; margin: 0 0 10px; }
  .recursos .listas li { background: none; border: 0; padding: 0; margin: 0 0 6px; border-radius: 0; }
  .acessivel { text-align: center; color: var(--suave); margin: 24px auto 0; max-width: 640px; }
  .contato { text-align: center; margin-top: 16px; }
</style>
